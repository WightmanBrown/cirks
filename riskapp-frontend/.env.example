# Frontend environment variables (Vite)
# Duplicate this file to .env.local for local development.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# In development, Vite proxies /api to Express on this URL.
# If you change the Express port, update vite.config.js as well.
# VITE_API_BASE_URL is NOT used in the code (proxy handles it),
# but it's documented here for reference.
VITE_API_BASE_URL=http://localhost:3000

# TOTP issuer label shown in authenticator apps.
# Must match TOTP_ISSUER in the backend .env.
VITE_TOTP_ISSUER=riskapp
