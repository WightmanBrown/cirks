# CIRKS docker-compose configuration. Copy to `.env` and fill in.
#   cp .env.docker.example .env
#
# `.env` is git-ignored — never commit real secrets.

# ── Database ─────────────────────────────────────────────────────────────────────
DB_USER=cirks
DB_NAME=cirks
# Choose a strong password (used by both the postgres container and the app).
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# ── Application ──────────────────────────────────────────────────────────────────
# Host port the SPA + API are published on → http://localhost:${APP_PORT}
APP_PORT=8080

# ── JWT secrets ──────────────────────────────────────────────────────────────────
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The app hard-fails at boot if these still start with REPLACE_.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_BYTE_HEX

# Token lifetimes (optional — sensible defaults applied if omitted).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Name shown in authenticator apps for TOTP enrolment.
TOTP_ISSUER=CIRKS

# ── Hardening ────────────────────────────────────────────────────────────────────
# Auth brute-force throttle (per IP): max attempts per window, window in minutes.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MIN=15

# Least-privilege DB role (H-01) — OPTIONAL. Leave APP_DB_PASSWORD blank to run
# the app as the owner (simple). Set it to a strong password to make migrations
# run as the owner while the app connects as a restricted role that can DML but
# not change the schema.
APP_DB_USER=cirks_app
APP_DB_PASSWORD=

# ── TLS (only used by the Caddy overlay: deploy/docker-compose.tls.yml) ───────────
# CIRKS terminates its own TLS. Set the public hostname, then pick ONE cert mode
# via CIRKS_TLS:
#   Bring your own cert: CIRKS_TLS=tls /certs/cert.pem /certs/key.pem
#                        (drop the files into deploy/certs/)
#   ACME/Let's Encrypt:  CIRKS_TLS=            (blank; or "tls you@example.org")
#   Self-signed/internal: CIRKS_TLS=tls internal
CIRKS_DOMAIN=cirks.example.org
CIRKS_TLS=

# ── Source link on the login screen ──────────────────────────────────────────────
# Leave blank to link to upstream CIRKS. If you run a MODIFIED CIRKS, set this to
# your own repository, so the link shows your users the code they are running.
CIRKS_SOURCE_URL=
